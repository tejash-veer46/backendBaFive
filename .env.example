# Port the API listens on
PORT=5000
# Long random string used to sign login tokens (required in production)
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of frontend origins allowed to call the API (* allows any)
CORS_ORIGIN=http://localhost:5173
# Production database (Turso). Leave unset to use a local SQLite file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
# Local database file when DATABASE_URL is unset (defaults to ./data/bafive.db)
# DB_PATH=./data/bafive.db
# Emails verification / password-reset codes through Brevo (https://brevo.com, free 300/day).
# Leave unset locally: codes are printed to the console instead.
# BREVO_API_KEY=
# Sender verified in Brevo, e.g. baFive <you@gmail.com>
# MAIL_FROM=
# Seed demo profiles that like you back and reply (set to false for a real launch)
DEMO_MODE=true
